:local config {
# Configuration of bot XXXXXX
"TToken"="0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX";
"TChatId"="-0000000000000";
"TWebhookURL"="my.dynamic.dns.address";
"TWebhookPort"="8443"
}

return $config
